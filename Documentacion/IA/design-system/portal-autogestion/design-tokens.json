{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Portal de Autogestión — Sistema de Diseño (Arquitectura de 3 capas: Primitive -> Semantic -> Component)",
  "primitive": {
    "color": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "navy": {
        "50":  { "$value": "#F1F5FF", "$type": "color" },
        "100": { "$value": "#E3ECFF", "$type": "color" },
        "200": { "$value": "#C8DAFD", "$type": "color" },
        "300": { "$value": "#ABC4FA", "$type": "color" },
        "400": { "$value": "#7CA5F5", "$type": "color" },
        "500": { "$value": "#4B83F0", "$type": "color" },
        "600": { "$value": "#2E6BE6", "$type": "color" },
        "700": { "$value": "#1B4FBF", "$type": "color" },
        "800": { "$value": "#0F2F80", "$type": "color" },
        "900": { "$value": "#0A2266", "$type": "color" },
        "950": { "$value": "#071A4D", "$type": "color" }
      },
      "amber": {
        "50":  { "$value": "#FFF6E5", "$type": "color" },
        "100": { "$value": "#FDE8BF", "$type": "color" },
        "200": { "$value": "#FBD58E", "$type": "color" },
        "300": { "$value": "#F6B84A", "$type": "color" },
        "400": { "$value": "#F3AE3C", "$type": "color" },
        "500": { "$value": "#EF9F27", "$type": "color" },
        "600": { "$value": "#B5790A", "$type": "color" },
        "700": { "$value": "#996605", "$type": "color" },
        "800": { "$value": "#7A5300", "$type": "color" }
      },
      "green": {
        "50":  { "$value": "#EAF7EE", "$type": "color" },
        "200": { "$value": "#A7DFB9", "$type": "color" },
        "600": { "$value": "#1B7F3A", "$type": "color" },
        "700": { "$value": "#14602B", "$type": "color" }
      },
      "red": {
        "50":  { "$value": "#FCEBEB", "$type": "color" },
        "200": { "$value": "#F3BABA", "$type": "color" },
        "600": { "$value": "#B83232", "$type": "color" },
        "700": { "$value": "#8F2020", "$type": "color" }
      },
      "sky": {
        "50":  { "$value": "#E0F2FE", "$type": "color" },
        "200": { "$value": "#BAE6FD", "$type": "color" },
        "700": { "$value": "#0369A1", "$type": "color" },
        "800": { "$value": "#075985", "$type": "color" }
      },
      "neutral": {
        "50":  { "$value": "#F8FAFC", "$type": "color" },
        "100": { "$value": "#F4F6FB", "$type": "color" },
        "200": { "$value": "#DDE3F0", "$type": "color" },
        "300": { "$value": "#CBD4E6", "$type": "color" },
        "400": { "$value": "#94A3B8", "$type": "color" },
        "600": { "$value": "#4A5675", "$type": "color" },
        "800": { "$value": "#1E293B", "$type": "color" },
        "900": { "$value": "#1A1F2E", "$type": "color" },
        "950": { "$value": "#081024", "$type": "color" }
      },
      "dark": {
        "surface":  { "$value": "#0F1A36", "$type": "color" },
        "elevated": { "$value": "#16254A", "$type": "color" },
        "border":   { "$value": "#253864", "$type": "color" },
        "muted":    { "$value": "#A9B8D9", "$type": "color" }
      }
    },
    "font": {
      "sans":    { "$value": "\"DM Sans\", \"Segoe UI\", Arial, sans-serif", "$type": "fontFamily" },
      "display": { "$value": "\"DM Sans\", \"Segoe UI\", Arial, sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "\"JetBrains Mono\", \"Cascadia Code\", ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "2xs":  { "$value": "0.6875rem", "$type": "dimension" },
      "xs":   { "$value": "0.75rem", "$type": "dimension" },
      "sm":   { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "0.9375rem", "$type": "dimension" },
      "md":   { "$value": "1rem", "$type": "dimension" },
      "lg":   { "$value": "1.125rem", "$type": "dimension" },
      "xl":   { "$value": "1.25rem", "$type": "dimension" },
      "2xl":  { "$value": "1.5rem", "$type": "dimension" },
      "3xl":  { "$value": "1.875rem", "$type": "dimension" },
      "4xl":  { "$value": "2.25rem", "$type": "dimension" }
    },
    "spacing": {
      "0":  { "$value": "0", "$type": "dimension" },
      "1":  { "$value": "0.25rem", "$type": "dimension" },
      "2":  { "$value": "0.5rem", "$type": "dimension" },
      "3":  { "$value": "0.75rem", "$type": "dimension" },
      "4":  { "$value": "1rem", "$type": "dimension" },
      "5":  { "$value": "1.25rem", "$type": "dimension" },
      "6":  { "$value": "1.5rem", "$type": "dimension" },
      "8":  { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension" },
      "sm":   { "$value": "0.375rem", "$type": "dimension" },
      "md":   { "$value": "0.5rem", "$type": "dimension" },
      "lg":   { "$value": "0.75rem", "$type": "dimension" },
      "xl":   { "$value": "1rem", "$type": "dimension" },
      "2xl":  { "$value": "1.25rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "none":   { "$value": "none", "$type": "shadow" },
      "xs":     { "$value": "0 1px 2px rgba(10, 34, 102, 0.06)", "$type": "shadow" },
      "card":   { "$value": "0 1px 2px rgba(15, 47, 128, 0.06), 0 8px 24px -12px rgba(15, 47, 128, 0.18)", "$type": "shadow" },
      "lift":   { "$value": "0 14px 32px -12px rgba(15, 47, 128, 0.30)", "$type": "shadow" },
      "brand":  { "$value": "0 8px 24px -6px rgba(7, 26, 77, 0.55)", "$type": "shadow" },
      "dialog": { "$value": "0 24px 48px -12px rgba(7, 26, 77, 0.35)", "$type": "shadow" }
    },
    "duration": {
      "fast":   { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "slow":   { "$value": "300ms", "$type": "duration" }
    }
  },
  "semantic": {
    "color": {
      "canvas":              { "$value": "{primitive.color.neutral.100}", "$type": "color" },
      "surface":             { "$value": "{primitive.color.white}", "$type": "color" },
      "surface-subtle":      { "$value": "{primitive.color.neutral.50}", "$type": "color" },
      "surface-tint":        { "$value": "{primitive.color.navy.50}", "$type": "color" },
      "foreground":          { "$value": "{primitive.color.neutral.900}", "$type": "color" },
      "foreground-heading":  { "$value": "{primitive.color.navy.800}", "$type": "color" },
      "muted-foreground":    { "$value": "{primitive.color.neutral.600}", "$type": "color" },
      "border":              { "$value": "{primitive.color.neutral.200}", "$type": "color" },
      "border-strong":       { "$value": "{primitive.color.neutral.300}", "$type": "color" },
      "border-brand":        { "$value": "{primitive.color.navy.200}", "$type": "color" },
      "primary":             { "$value": "{primitive.color.navy.700}", "$type": "color" },
      "primary-hover":       { "$value": "{primitive.color.navy.800}", "$type": "color" },
      "primary-active":      { "$value": "{primitive.color.navy.900}", "$type": "color" },
      "primary-foreground":  { "$value": "{primitive.color.white}", "$type": "color" },
      "accent":              { "$value": "{primitive.color.amber.500}", "$type": "color" },
      "accent-hover":        { "$value": "{primitive.color.amber.300}", "$type": "color" },
      "accent-foreground":   { "$value": "{primitive.color.navy.900}", "$type": "color" },
      "ring":                { "$value": "{primitive.color.navy.700}", "$type": "color" },
      "success":             { "$value": "{primitive.color.green.600}", "$type": "color" },
      "success-hover":       { "$value": "{primitive.color.green.700}", "$type": "color" },
      "success-foreground":  { "$value": "{primitive.color.green.700}", "$type": "color" },
      "success-bg":          { "$value": "{primitive.color.green.50}", "$type": "color" },
      "success-border":      { "$value": "{primitive.color.green.200}", "$type": "color" },
      "warning":             { "$value": "{primitive.color.amber.600}", "$type": "color" },
      "warning-foreground":  { "$value": "{primitive.color.amber.800}", "$type": "color" },
      "warning-bg":          { "$value": "{primitive.color.amber.50}", "$type": "color" },
      "warning-border":      { "$value": "{primitive.color.amber.200}", "$type": "color" },
      "danger":              { "$value": "{primitive.color.red.600}", "$type": "color" },
      "danger-hover":        { "$value": "{primitive.color.red.700}", "$type": "color" },
      "danger-foreground":   { "$value": "{primitive.color.red.700}", "$type": "color" },
      "danger-bg":           { "$value": "{primitive.color.red.50}", "$type": "color" },
      "danger-border":       { "$value": "{primitive.color.red.200}", "$type": "color" },
      "info":                { "$value": "{primitive.color.sky.700}", "$type": "color" },
      "info-foreground":     { "$value": "{primitive.color.sky.800}", "$type": "color" },
      "info-bg":             { "$value": "{primitive.color.sky.50}", "$type": "color" },
      "info-border":         { "$value": "{primitive.color.sky.200}", "$type": "color" }
    },
    "spacing": {
      "page-x":    { "$value": "{primitive.spacing.8}", "$type": "dimension" },
      "page-y":    { "$value": "{primitive.spacing.8}", "$type": "dimension" },
      "section":   { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "component": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "tight":     { "$value": "{primitive.spacing.2}", "$type": "dimension" }
    }
  },
  "component": {
    "card": {
      "bg":      { "$value": "{semantic.color.surface}", "$type": "color" },
      "border":  { "$value": "{semantic.color.border}", "$type": "color" },
      "radius":  { "$value": "{primitive.radius.xl}", "$type": "dimension" },
      "padding": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "shadow":  { "$value": "{primitive.shadow.card}", "$type": "shadow" }
    },
    "button": {
      "min-height":  { "$value": "2.75rem", "$type": "dimension" },
      "mini-height": { "$value": "2.25rem", "$type": "dimension" },
      "radius":      { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "padding-x":   { "$value": "{primitive.spacing.5}", "$type": "dimension" },
      "padding-y":   { "$value": "0.625rem", "$type": "dimension" },
      "bg":          { "$value": "{semantic.color.primary}", "$type": "color" },
      "bg-hover":    { "$value": "{semantic.color.primary-hover}", "$type": "color" },
      "fg":          { "$value": "{semantic.color.primary-foreground}", "$type": "color" }
    },
    "input": {
      "min-height":  { "$value": "2.875rem", "$type": "dimension" },
      "bg":          { "$value": "{semantic.color.surface}", "$type": "color" },
      "border":      { "$value": "{semantic.color.border-strong}", "$type": "color" },
      "border-focus":{ "$value": "{semantic.color.ring}", "$type": "color" },
      "radius":      { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "padding-x":   { "$value": "0.875rem", "$type": "dimension" },
      "padding-y":   { "$value": "0.625rem", "$type": "dimension" }
    },
    "table": {
      "header-bg":   { "$value": "{primitive.color.navy.900}", "$type": "color" },
      "header-fg":   { "$value": "{primitive.color.white}", "$type": "color" },
      "row-hover":   { "$value": "{primitive.color.navy.50}", "$type": "color" },
      "row-border":  { "$value": "{semantic.color.border}", "$type": "color" },
      "radius":      { "$value": "{primitive.radius.xl}", "$type": "dimension" }
    },
    "badge": {
      "radius":      { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "padding-x":   { "$value": "0.625rem", "$type": "dimension" },
      "padding-y":   { "$value": "0.25rem", "$type": "dimension" }
    },
    "alert": {
      "radius":      { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "padding-x":   { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "padding-y":   { "$value": "{primitive.spacing.3}", "$type": "dimension" }
    },
    "sidebar": {
      "width":       { "$value": "18rem", "$type": "dimension" },
      "bg-start":    { "$value": "{primitive.color.navy.900}", "$type": "color" },
      "bg-mid":      { "$value": "{primitive.color.navy.800}", "$type": "color" },
      "bg-end":      { "$value": "{primitive.color.navy.950}", "$type": "color" },
      "accent":      { "$value": "{primitive.color.amber.500}", "$type": "color" }
    }
  },
  "dark": {
    "semantic": {
      "color": {
        "canvas":             { "$value": "{primitive.color.neutral.950}", "$type": "color" },
        "surface":            { "$value": "{primitive.color.dark.surface}", "$type": "color" },
        "surface-subtle":     { "$value": "{primitive.color.dark.elevated}", "$type": "color" },
        "surface-tint":       { "$value": "{primitive.color.dark.elevated}", "$type": "color" },
        "foreground":         { "$value": "{primitive.color.navy.50}", "$type": "color" },
        "foreground-heading": { "$value": "{primitive.color.navy.100}", "$type": "color" },
        "muted-foreground":   { "$value": "{primitive.color.dark.muted}", "$type": "color" },
        "border":             { "$value": "{primitive.color.dark.border}", "$type": "color" },
        "border-strong":      { "$value": "{primitive.color.dark.border}", "$type": "color" },
        "border-brand":       { "$value": "{primitive.color.navy.700}", "$type": "color" },
        "primary":            { "$value": "{primitive.color.navy.500}", "$type": "color" },
        "primary-hover":      { "$value": "{primitive.color.navy.400}", "$type": "color" },
        "ring":               { "$value": "{primitive.color.navy.400}", "$type": "color" }
      }
    }
  }
}
